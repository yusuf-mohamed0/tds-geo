{
  "name": "ai-seo-automation",
  "version": "2.0.0",
  "description": "AI-powered SEO automation SaaS platform for Shopify blogs",
  "main": "dist/backend/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/backend/index.js",
    "dev": "tsx watch backend/index.ts",
    "dev:full": "./scripts/start-dev.sh",
    "worker": "tsx backend/workers/index.ts",
    "migrate": "psql $DATABASE_URL -f backend/database/schema.sql",
    "migrate:upgrade": "psql $DATABASE_URL -f backend/database/migration_v2.sql",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "lint": "eslint backend/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "keywords": [
    "seo",
    "shopify",
    "ai",
    "automation",
    "content-generation",
    "saas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@rollup/rollup-linux-x64-gnu": "^4.60.4",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "marked": "^12.0.2",
    "n8n": "^2.21.8",
    "openai": "^4.52.3",
    "pg": "^8.12.0",
    "playwright": "^1.60.0",
    "serpapi": "^2.0.3",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "eslint": "^8.57.0",
    "supertest": "^7.2.2",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
