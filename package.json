{
  "name": "kivo-os",
  "version": "2.0.1",
  "description": "Kivo OS — technical visibility infrastructure for AI search, commerce content, telemetry, and automated recovery. <YKS /> Code. Build. Ship.™",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusuf-mohamed0/kivo.git"
  },
  "bugs": {
    "url": "https://github.com/yusuf-mohamed0/kivo/issues"
  },
  "homepage": "https://github.com/yusuf-mohamed0/kivo#readme",
  "main": "dist/backend/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/backend/index.js",
    "dev": "tsx watch backend/index.ts",
    "dev:full": "./scripts/start-dev.sh",
    "start:all": "./scripts/start-all.sh",
    "worker": "tsx backend/workers/index.ts",
    "migrate": "psql $DATABASE_URL -f backend/database/schema.sql",
    "migrate:upgrade": "psql $DATABASE_URL -f backend/database/migration_v2.sql",
    "migrate:vault": "psql $DATABASE_URL -f backend/database/migration_credential_vault.sql",
    "vault": "tsx backend/scripts/vault.ts",
    "vault:rotate": "tsx backend/scripts/rotateVaultKey.ts",
    "import:credentials": "tsx backend/scripts/importCredentials.ts",
    "shopify:webhooks:update": "tsx backend/scripts/update-webhooks.ts",
    "audit:clients": "node scripts/audit-clients.mjs",
    "eval:pages": "node scripts/evaluate-frontend-pages.mjs",
    "test": "vitest run",
    "test:py": "python -m pytest backend/services/vectorStore/test_server.py backend/services/localLLM/test_airllm.py -q",
    "test:all": "vitest run && python -m pytest backend/services/vectorStore/test_server.py backend/services/localLLM/test_airllm.py -q",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "lint": "eslint backend/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "keywords": [
    "seo",
    "shopify",
    "ai",
    "automation",
    "content-generation",
    "saas",
    "yusuf-ko-sta",
    "yks"
  ],
  "author": "Yusuf Mohamed — YUSUF KO STA < />",
  "license": "ISC",
  "dependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.4",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "limax": "^4.2.3",
    "marked": "^12.0.2",
    "nodemailer": "^9.0.1",
    "ollama": "^0.6.3",
    "openai": "^6.42.0",
    "pg": "^8.12.0",
    "serpapi": "^2.0.3",
    "uuid": "^11.1.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^8.57.0",
    "supertest": "^7.2.2",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
