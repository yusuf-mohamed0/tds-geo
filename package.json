{
  "name": "ai-seo-automation",
  "version": "2.0.1",
  "description": "AI SEO automation — multi-tenant content pipeline, Shopify publishing, and product engine. <YKS /> Code. Build. Ship.™",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusuf-mohamed0/tds-geo.git"
  },
  "bugs": {
    "url": "https://github.com/yusuf-mohamed0/tds-geo/issues"
  },
  "homepage": "https://github.com/yusuf-mohamed0/tds-geo#readme",
  "main": "dist/backend/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/backend/index.js",
    "dev": "tsx watch backend/index.ts",
    "dev:full": "./scripts/start-dev.sh",
    "start:all": "./scripts/start-all.sh",
    "worker": "tsx backend/workers/index.ts",
    "migrate": "psql $DATABASE_URL -f backend/database/schema.sql",
    "migrate:upgrade": "psql $DATABASE_URL -f backend/database/migration_v2.sql",
    "migrate:vault": "psql $DATABASE_URL -f backend/database/migration_credential_vault.sql",
    "vault": "tsx backend/scripts/vault.ts",
    "vault:rotate": "tsx backend/scripts/rotateVaultKey.ts",
    "import:credentials": "tsx backend/scripts/importCredentials.ts",
    "shopify:webhooks:update": "tsx backend/scripts/update-webhooks.ts",
    "audit:clients": "node scripts/audit-clients.mjs",
    "eval:pages": "node scripts/evaluate-frontend-pages.mjs",
    "test": "vitest run",
    "test:py": "python -m pytest backend/services/vectorStore/test_server.py backend/services/localLLM/test_airllm.py -q",
    "test:all": "vitest run && python -m pytest backend/services/vectorStore/test_server.py backend/services/localLLM/test_airllm.py -q",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "lint": "eslint backend/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "keywords": [
    "seo",
    "shopify",
    "ai",
    "automation",
    "content-generation",
    "saas",
    "yusuf-ko-sta",
    "yks"
  ],
  "author": "Yusuf Mohamed — YUSUF KO STA < />",
  "license": "ISC",
  "dependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.5",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "limax": "^4.2.3",
    "marked": "^18.0.7",
    "nodemailer": "^9.0.1",
    "ollama": "^0.6.3",
    "openai": "^7.3.0",
    "pg": "^8.12.0",
    "serpapi": "^2.0.3",
    "uuid": "^11.1.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
