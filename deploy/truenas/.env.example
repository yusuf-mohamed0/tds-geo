COMPOSE_PROJECT_NAME=tds-geo
TDS_IMAGE=ghcr.io/yusuf-mohamed0/tds-geo:truenas

TDS_PUBLIC_HOSTNAME=tds.example.com
TDS_PUBLIC_URL=https://tds.example.com

NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-long-random-secret
CREDENTIAL_VAULT_KEY=replace-with-64-hex-chars
ENCRYPTION_KEY=replace-with-64-hex-chars

DB_USER=tds_geo
DB_PASSWORD=replace-with-strong-password
DB_NAME=ai_seo_automation
DATABASE_URL=postgresql://tds_geo:replace-with-strong-password@postgres:5432/ai_seo_automation

REDIS_URL=redis://redis:6379

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_FALLBACK_KEY=
AI_PROVIDER=ollama
OLLAMA_BASE_URL=
SERPAPI_API_KEY=
DATAFORSEO_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://tds.example.com
SHOPIFY_DEFAULT_SHOP=
SHOPIFY_DEFAULT_ACCESS_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tds.example.com/api/gsc/callback

# Google Search Console can use the GOOGLE_* values above. Set these only if
# you need a separate OAuth client for GSC.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=

FREELMAPI_ENCRYPTION_KEY=
HEADROOM_BASE_URL=http://headroom:8787
CRAWL4AI_URL=http://crawl4ai:11235
OPENSEO_URL=http://openseo:3001

TDS_DATA_ROOT=/mnt/tds-geo
POSTGRES_DATA=/mnt/tds-geo/postgres
REDIS_DATA=/mnt/tds-geo/redis
BACKUP_DIR=/mnt/tds-geo/backups
LOG_DIR=/mnt/tds-geo/logs
CLOUDFLARED_DIR=/mnt/tds-geo/cloudflared
BACKUP_RETENTION_DAYS=14
PRE_DEPLOY_BACKUP_REQUIRED=true

CLOUDFLARED_TOKEN=
ENABLE_CLOUDFLARED=false
ENABLE_DIRECT_HTTPS=false
