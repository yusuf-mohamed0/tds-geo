# ─── Staging Environment ─────────────────────────────────
NODE_ENV=staging
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_seo_automation

# Auth
JWT_SECRET=change-me-staging-jwt-secret
JWT_EXPIRES_IN=24h

# Redis
REDIS_URL=redis://redis:6379

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_DEFAULT_SHOP=
SHOPIFY_DEFAULT_ACCESS_TOKEN=

# Monitoring
HEARTBEAT_EMAIL=
HEARTBEAT_FREQUENCY_MINUTES=15
