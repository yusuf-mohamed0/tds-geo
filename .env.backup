# ──────────────────────────────────────────────
# AI SEO Automation System - Environment Variables
# ──────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# ─── OpenAI ───────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# ─── Shopify Admin API ────────────────────────
# Store-specific credentials — prefix with client ID for multi-client support
# Example for client "main": SHOPIFY_MAIN_SHOP=..., SHOPIFY_MAIN_ACCESS_TOKEN=...
# The system will read SHOPIFY_DEFAULT_* as the primary store.

# Primary store
SHOPIFY_DEFAULT_SHOP=your-store.myshopify.com
SHOPIFY_DEFAULT_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_DEFAULT_API_VERSION=2024-07

# Shopify API rate limits (requests per second)
# Most Shopify stores allow 40 req/min = 1 every 1500ms
SHOPIFY_RATE_LIMIT_MAX_CONCURRENT=2
SHOPIFY_RATE_LIMIT_MIN_TIME=1500

# ─── PostgreSQL ───────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ai_seo_automation
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_seo_automation
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Keyword Research ─────────────────────────
# Optional: SerpAPI or similar for keyword research
SERPAPI_API_KEY=
KEYWORD_CACHE_TTL_DAYS=7
KEYWORD_DEDUP_WINDOW_DAYS=90
MIN_KEYWORD_VOLUME=100
MAX_KEYWORD_COMPETITION=0.7

# ─── Content Generation ───────────────────────
DEFAULT_LOCALE=en-US
CONTENT_MIN_WORDS=1200
CONTENT_MAX_WORDS=2500
AVOID_DIY_REPAIR_KEYWORDS=replace breaker,remove panel,disconnect wire,bypass safety
CTA_DEFAULT_TEXT=Contact a professional today for a free inspection and estimate.
CTA_DEFAULT_URL=https://your-site.com/contact

# ─── Internal Linking ─────────────────────────
MAX_INTERNAL_LINKS_PER_ARTICLE=3
MIN_WORDS_BETWEEN_LINKS=300

# ─── Queue / Rate Limiting ────────────────────
QUEUE_MAX_CONCURRENT=2
QUEUE_MIN_TIME_MS=1500

# ─── Logging ──────────────────────────────────
LOG_LEVEL=info
LOG_FILE_PATH=logs/automation.log
