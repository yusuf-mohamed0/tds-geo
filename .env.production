# ─── Production Environment ───────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=https://app.tdsgeo.com
SITE_NAME=TDS Geo

# Database
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@postgres:5432/ai_seo_automation
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=30000

# Auth
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_EXPIRES_IN=2h

# Redis
REDIS_URL=redis://redis:6379

# OpenAI (primary)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FALLBACK_API_KEY=
OPENAI_MODEL=gpt-4o

# FreeLLM API (fallback provider pool)
FREELLMAPI_ENCRYPTION_KEY=
FREELLMAPI_URL=http://freellmapi:3001

# Headroom (prompt compression)
HEADROOM_URL=http://headroom:8787

# Crawl4AI
CRAWL4AI_URL=http://crawl4ai:11235

# OpenSEO (DataForSEO)
OPENSEO_URL=http://openseo:3001
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_DEFAULT_SHOP=
SHOPIFY_DEFAULT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-07

# WordPress Plugin
TDS_GEO_WORDPRESS_URL=
TDS_GEO_WORDPRESS_API_KEY=

# SerpAPI (optional)
SERPAPI_API_KEY=

# Pexels (optional)
PEXELS_API_KEY=

# Ollama (local inference, optional)
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3
OLLAMA_TEMPERATURE=0.7

# Vector Store (Python microservice)
TURBOVEC_URL=http://turbovec:8530
AIRLLM_URL=http://airllm:8531

# Monitoring
HEARTBEAT_EMAIL=
HEARTBEAT_FREQUENCY_MINUTES=5
HEARTBEAT_SMTP_HOST=smtp.gmail.com
HEARTBEAT_SMTP_PORT=587
HEARTBEAT_SMTP_USER=
HEARTBEAT_SMTP_PASS=

# IndexNow (search engine notification)
INDEXNOW_KEY=
INDEXNOW_HOST=app.tdsgeo.com

# Sentry (error tracking, optional)
SENTRY_DSN=

# Credential Vault
CREDENTIAL_VAULT_KEY=

# Security
IP_WHITELIST=
VPN_AUTH_TOKEN=
