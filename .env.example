# Vireon — Environment Configuration
# Copy this file to .env and fill in your own credentials
# Never commit .env to git — it contains secrets!

# === DATABASE ===
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_seo_automation

# === AUTHENTICATION ===
# Generate a random string for JWT signing
# You can generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-string

# === SERVER ===
PORT=3000
CORS_ORIGIN=http://localhost:5173

# === OPENAI ===
# Required for AI content generation
# Get your key at: https://platform.openai.com/api-keys
# Leave empty to run in dev mock mode
OPENAI_API_KEY=

# AI provider selection (openai | ollama)
# When set to 'ollama', the pipeline routes to OllamaService instead of OpenAIService.
# Both can run side-by-side — cost optimizer picks the best model regardless.
AI_PROVIDER=openai

# === SHOPIFY ===
# For publishing articles to your Shopify store
SHOPIFY_DEFAULT_SHOP=your-store.myshopify.com
SHOPIFY_DEFAULT_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# === KOZMO AI WORDPRESS PLUGIN ===
# Connect the backend to the KOZMO AI WordPress plugin
# URL: Your WordPress site URL (e.g. https://trafficdigitalsolutions.com)
KOZMO_AI_WORDPRESS_URL=

# API Key: Generate from WordPress admin → KOZMO AI → API Keys
KOZMO_AI_WORDPRESS_API_KEY=

# === OPTIONAL ===
# SerpAPI: https://serpapi.com/
SERPAPI_API_KEY=

# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=

# === OLLAMA (Alternative AI Provider) ===
# Ollama base URL — leave blank for http://127.0.0.1:11434 (local)
# For Ollama Cloud, set to: https://api.ollama.com
OLLAMA_BASE_URL=

# Ollama API key — required for Ollama Cloud, leave blank for local inference
OLLAMA_API_KEY=

# Default Ollama model to use (local models: llama3.1:8b, mistral:7b, mixtral:8x7b, llama3.2:3b)
# Cloud models: llama3.1:8b-cloud, llama3.1:70b-cloud
OLLAMA_MODEL=llama3.1:8b

# Ollama inference settings
OLLAMA_MAX_TOKENS=4096
OLLAMA_TEMPERATURE=0.7

# === REDIS ===
# Redis for BullMQ queue (optional)
REDIS_URL=redis://localhost:6379

# === DEVICE AUTHORIZATION ===
# Enable/disable device-based authentication
DEVICE_ENABLED=true

# Automatically enroll new devices on first login
DEVICE_AUTO_ENROLL=true

# Minimum trust score required for device access (0-100)
DEVICE_MIN_TRUST_SCORE=30

# Require device auth even for super_admin
DEVICE_AUTH_REQUIRED_FOR_ALL=false

# Salt for device fingerprint hashing (generate with: openssl rand -hex 32)
DEVICE_FINGERPRINT_SALT=change-this-to-a-random-salt

# === NETWORK SECURITY ===
# Comma-separated list of allowed IPs (leave blank for internal-only)
INTERNAL_IP_WHITELIST=

# VPN auth token for X-VPN-Verified header
VPN_AUTH_TOKEN=

# Disable VPN check (for development)
DISABLE_VPN_CHECK=true

# Disable internal network check (for development)
DISABLE_INTERNAL_NETWORK_CHECK=true

# JWT expiry (hours)
JWT_EXPIRES_IN=24

# === TURBOVEC VECTOR STORE ===
# Python microservice for fast vector search (TurboQuant)
# Started via: bash scripts/start-vector-store.sh
TVEC_URL=http://127.0.0.1:8530
TVEC_PORT=8530
TVEC_BIT_WIDTH=4
TVEC_DIM=1536

# === AIRLLM LOCAL INFERENCE ===
# Python microservice for local LLM inference via AirLLM
# Started via: python3 backend/services/localLLM/server.py
AIRLLM_URL=http://127.0.0.1:8531
AIRLLM_PORT=8531
AIRLLM_MODEL=
AIRLLM_COMPRESSION=

# === VECTOR INDEX DATA ===
# Where turbovec persists index files to disk
TVEC_DATA_DIR=/tmp/turbovec_indices
