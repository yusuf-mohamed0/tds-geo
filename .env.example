# Vireon — Environment Configuration
# Copy this file to .env and fill in your credentials

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_seo_automation

# Authentication
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# OpenAI API (leave empty for dev mock mode)
OPENAI_API_KEY=

# Shopify (default store)
SHOPIFY_DEFAULT_SHOP=your-store.myshopify.com
SHOPIFY_DEFAULT_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# Optional: SerpAPI for keyword volume data
SERPAPI_API_KEY=

# Optional: Pexels API for article images
PEXELS_API_KEY=

# Optional: Redis for BullMQ queue
REDIS_URL=redis://localhost:6379
