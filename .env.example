# TDS Geo — Environment Configuration
# Copy this file to .env and fill in your own credentials
# Never commit .env to git — it contains secrets!

# === DATABASE ===
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_seo_automation

# === AUTHENTICATION ===
# Generate a random string for JWT signing
# You can generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-string

# === SERVER ===
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# === OPENAI ===
# Required for AI content generation
# Get your key at: https://platform.openai.com/api-keys
# Leave empty to run in dev mock mode
OPENAI_API_KEY=

# Base URL for OpenAI-compatible API (e.g., FreeLLMAPI proxy)
# Set to http://freellmapi:3001/v1 when using Docker Compose with FreeLLMAPI
# Leave blank to use OpenAI directly (https://api.openai.com/v1)
OPENAI_BASE_URL=

# Fallback OpenAI key used when OPENAI_BASE_URL points to a proxy like FreeLLMAPI,
# and the proxy is unavailable. Leave blank if not using a proxy.
OPENAI_FALLBACK_KEY=

# AI provider selection (openai | ollama)
# When set to 'ollama', the pipeline routes to OllamaService instead of OpenAIService.
# Both can run side-by-side — cost optimizer picks the best model regardless.
AI_PROVIDER=openai

# === FREELLMAPI (Free LLM Proxy) ===
# Free tier aggregator for 16+ LLM providers (~1.7B tokens/month combined)
# See: https://github.com/tashfeenahmed/freellmapi
#
# Setup:
#   1. Generate encryption key: openssl rand -hex 32
#   2. Start containers: docker compose up -d
#   3. Visit http://localhost:3001 to add provider API keys
#   4. Copy the generated unified key into OPENAI_API_KEY above
#   5. Set OPENAI_BASE_URL=http://freellmapi:3001/v1
#
# Encryption key for FreeLLMAPI's SQLite key storage (64-char hex)
# Generate: openssl rand -hex 32
FREELMAPI_ENCRYPTION_KEY=

# === HEADROOM (Prompt Compression) ===
# Token compression proxy: compresses prompts 60-95% before sending to LLM.
# See: https://github.com/chopratejas/headroom
#
# Setup:
#   1. Start containers: docker compose up -d
#   2. Set base URL to the headroom proxy endpoint
#
# For Docker Compose: http://headroom:8787
# For local install: http://localhost:8787
# Leave blank to skip compression
HEADROOM_BASE_URL=

# === CRAWL4AI (Web Crawling) ===
# Self-hosted web crawler that returns clean markdown for AI pipelines.
# See: https://github.com/unclecode/crawl4ai
#
# For Docker Compose: http://crawl4ai:11235
# Leave blank to skip competitor research
CRAWL4AI_URL=

# === OPENSEO (SEO Toolkit) ===
# Self-hosted Semrush/Ahrefs alternative. Docker sidecar on port 3005.
# See: https://github.com/every-app/open-seo
#
# Requires DataForSEO API key: https://dataforseo.com
# Base64 format: echo -n "login:password" | base64
#
# Local: http://localhost:3005
# Docker: http://openseo:3001 (internal compose network)
# Leave blank to skip SEO intelligence
OPENSEO_URL=
DATAFORSEO_API_KEY=

# === SHOPIFY ===
# Custom App with Admin API access token (create in Shopify Admin → Apps → Dev Dashboard)
SHOPIFY_DEFAULT_SHOP=traffic-test.myshopify.com
SHOPIFY_DEFAULT_ACCESS_TOKEN=your-shopify-access-token-here
SHOPIFY_DEFAULT_API_VERSION=2024-07

# === Traffic Digital Solutions GEO WORDPRESS PLUGIN ===
# Connect the backend to the Traffic Digital Solutions GEO WordPress plugin
# URL: Your WordPress site URL (e.g. https://trafficdigitalsolutions.com)
TDS_GEO_WORDPRESS_URL=

# API Key: Generate from WordPress admin → Traffic Digital Solutions GEO → API Keys
TDS_GEO_WORDPRESS_API_KEY=

# === OPTIONAL ===
# SerpAPI: https://serpapi.com/
SERPAPI_API_KEY=

# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=

# === OLLAMA (Alternative AI Provider) ===
# Ollama base URL — leave blank for http://127.0.0.1:11434 (local)
# For Ollama Cloud, set to: https://api.ollama.com
OLLAMA_BASE_URL=

# Ollama API key — required for Ollama Cloud, leave blank for local inference
OLLAMA_API_KEY=

# Default Ollama model to use (local models: llama3.1:8b, mistral:7b, mixtral:8x7b, llama3.2:3b)
# Cloud models: llama3.1:8b-cloud, llama3.1:70b-cloud
OLLAMA_MODEL=llama3.1:8b

# Ollama inference settings
OLLAMA_MAX_TOKENS=4096
OLLAMA_TEMPERATURE=0.7

# === REDIS ===
# Redis for BullMQ queue (optional)
REDIS_URL=redis://localhost:6379

# === DEVICE AUTHORIZATION ===
# Enable/disable device-based authentication
DEVICE_ENABLED=true

# Automatically enroll new devices on first login
DEVICE_AUTO_ENROLL=true

# Minimum trust score required for device access (0-100)
DEVICE_MIN_TRUST_SCORE=30

# Require device auth even for super_admin
DEVICE_AUTH_REQUIRED_FOR_ALL=false

# Salt for device fingerprint hashing (generate with: openssl rand -hex 32)
DEVICE_FINGERPRINT_SALT=change-this-to-a-random-salt

# === NETWORK SECURITY ===
# Comma-separated list of allowed IPs (leave blank for internal-only)
INTERNAL_IP_WHITELIST=

# VPN auth token for X-VPN-Verified header
VPN_AUTH_TOKEN=

# Disable VPN check (for development)
DISABLE_VPN_CHECK=true

# Disable internal network check (for development)
DISABLE_INTERNAL_NETWORK_CHECK=true

# JWT expiry (hours)
JWT_EXPIRES_IN=24

# === TURBOVEC VECTOR STORE ===
# Python microservice for fast vector search (TurboQuant)
# Started via: bash scripts/start-vector-store.sh
TVEC_URL=http://127.0.0.1:8530
TVEC_PORT=8530
TVEC_BIT_WIDTH=4
TVEC_DIM=1536

# === AIRLLM LOCAL INFERENCE ===
# Python microservice for local LLM inference via AirLLM
# Started via: python3 backend/services/localLLM/server.py
AIRLLM_URL=http://127.0.0.1:8531
AIRLLM_PORT=8531
AIRLLM_MODEL=
AIRLLM_COMPRESSION=

# === HEARTBEAT MONITOR ===
# Sends email alert if the server goes down (every 5 min via cron)
# Requires Gmail App Password: https://myaccount.google.com/apppasswords
HEARTBEAT_URL=http://localhost:3001/api/admin/health
HEARTBEAT_EMAIL_TO=youssif.m.h.g13@gmail.com
SMTP_USER=
SMTP_PASS=

# === VECTOR INDEX DATA ===
# Where turbovec persists index files to disk
TVEC_DATA_DIR=/tmp/turbovec_indices
